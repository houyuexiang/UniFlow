{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Dispose 丢弃状态机",
    "subtitle": "发送窗口=10、等待确认、5 分钟重排队（最多 24 次）与终态",
    "output": "docs/dispose-state-machine.html",
    "viewBox": [
      1120,
      760
    ],
    "quality_profile": "standard",
    "views": [
      {
        "id": "main-loop",
        "label": "主循环",
        "focus": [
          "none",
          "ready",
          "ack",
          "dispose"
        ],
        "note": "从空闲到发送、等待确认、收尾回到空闲。"
      },
      {
        "id": "window-waits",
        "label": "窗口等待",
        "focus": [
          "ready",
          "waitActive",
          "waitInFlight",
          "waitNode"
        ],
        "note": "插入窗口、在途窗口、节点未就绪/投递失败时的等待路径。"
      },
      {
        "id": "maintenance-terminal",
        "label": "维护与终态",
        "focus": [
          "maint",
          "resend",
          "disposed",
          "skipped",
          "failed"
        ],
        "note": "每 60 秒补查、每 5 分钟重排队；命中 &3 为已丢弃，24 次用尽为失败，未知节点为跳过。"
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "主循环（一次一条）"
    },
    {
      "id": "waiting",
      "label": "窗口 / 等待"
    },
    {
      "id": "maint",
      "label": "60 秒维护（并行）"
    },
    {
      "id": "terminal",
      "label": "终态"
    }
  ],
  "states": [
    {
      "id": "none",
      "type": "start",
      "label": "None 空闲",
      "sublabel": "清历史 → 有待发就 Ready",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "入口"
    },
    {
      "id": "ready",
      "type": "decision",
      "label": "Ready 准备发送",
      "sublabel": "窗口 / STATUS / 节点检查",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "发送闸门"
    },
    {
      "id": "ack",
      "type": "waiting",
      "label": "Ack 等待确认",
      "sublabel": "查 &3-{node}-%，最多 MaxWait 轮",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "等待"
    },
    {
      "id": "dispose",
      "type": "active",
      "label": "Dispose 收尾",
      "sublabel": "STATUS 回包 → None",
      "lane": "main",
      "col": 3,
      "step": "04",
      "tag": "收尾"
    },
    {
      "id": "waitActive",
      "type": "waiting",
      "label": "插入窗口满",
      "sublabel": "active ≥ 10：不插新记录",
      "lane": "waiting",
      "col": 0,
      "tag": "插入闸门"
    },
    {
      "id": "waitInFlight",
      "type": "waiting",
      "label": "在途窗口满",
      "sublabel": "inFlight ≥ 10：不发 COMMENT/STATUS",
      "lane": "waiting",
      "col": 1,
      "tag": "发送闸门"
    },
    {
      "id": "waitNode",
      "type": "waiting",
      "label": "节点未就绪 / 投递失败",
      "sublabel": "STB 默认等待；AllowStandbyDispose=true 时可丢弃（测试）",
      "lane": "waiting",
      "col": 2,
      "tag": "重试"
    },
    {
      "id": "maint",
      "type": "active",
      "label": "每 60s 维护",
      "sublabel": "补查 &3 → 重排队 → 失败标记",
      "lane": "maint",
      "col": 0,
      "yOffset": 100,
      "tag": "并行"
    },
    {
      "id": "resend",
      "type": "active",
      "label": "5 分钟重排队",
      "sublabel": "只放回待发队列；24 次后失败",
      "lane": "maint",
      "col": 2,
      "yOffset": 100,
      "tag": "重排队"
    },
    {
      "id": "disposed",
      "type": "success",
      "label": "disposed=1 已丢弃",
      "sublabel": "&3-{node}-% 命中",
      "lane": "terminal",
      "col": 0,
      "tag": "终态"
    },
    {
      "id": "skipped",
      "type": "neutral",
      "label": "send=2 跳过",
      "sublabel": "未知节点 / SkipOnUnknownNode",
      "lane": "terminal",
      "col": 1,
      "tag": "终态"
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "send=3 失败",
      "sublabel": "24 次仍未丢弃，人工处置",
      "lane": "terminal",
      "col": 2,
      "tag": "终态"
    }
  ],
