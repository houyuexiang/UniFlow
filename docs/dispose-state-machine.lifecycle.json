  "cards": [
    {
      "dot": "amber",
      "title": "发送窗口 = 10",
      "items": [
        "active = send=0 待发 + send=1 未确认；active≥10 不再插新记录",
        "inFlight = send=1 且 disposed=0；inFlight≥10 不发任何 COMMENT/STATUS",
        "有 send=0 时先发（不受 active 闸门阻断），否则 10 条待发会永远卡在 None"
      ]
    },
    {
      "dot": "cyan",
      "title": "确认与重排队",
      "items": [
        "丢弃是否成功只看 t_sample.t_location 是否变为 &3-{node}-%",
        "每 60 秒补查（只查库）；每 5 分钟重排队：命中才放回待发队列，不直接发",
        "重发 24 次仍无 &3 → send=3 失败，释放窗口",
        "STB 默认等待；AllowStandbyDispose=true 时 STB/Pink 也可丢弃（GTO 始终不允许）"
      ]
    },
    {
      "dot": "rose",
      "title": "页面人工处置",
      "items": [
        "重新检查：立即查 &3，命中则 disposed=1",
        "重置：send=0、resend_count=0、checkcount=0，重新入队",
        "清空：删除 sam_dispose_status 记录（二次确认）"
      ]
    }
  ]
}